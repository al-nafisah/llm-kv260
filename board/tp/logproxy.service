[Unit]
# Logs prompts and requester geo between cloudflared and board 1.
#   install: cp board/tp/logproxy.service ~/.config/systemd/user/
#            systemctl --user daemon-reload && systemctl --user enable --now logproxy
# Then point ~/.cloudflared/kv260.yml at http://127.0.0.1:8081 and restart
# cloudflared-kv260.  Rollback is that one line back to http://10.42.0.137:8080.
Description=Logging proxy for the four-KV260 LLM API (prompts + requester geo)
After=network-online.target
Before=cloudflared-kv260.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/Desktop/llm-kv260/board/tp/logproxy.py
Environment=LISTEN=127.0.0.1:8081
Environment=UPSTREAM=10.42.0.137:8080
# Environment=HASH_IPS=1     # log a salted hash instead of the raw IP
# Environment=LOG_POLLS=1    # log every /health and /stats hit, not just a rollup
# Environment=MAX_BODY_KB=0  # disable the 1 MB request-body cap
Restart=always
RestartSec=1
UMask=0077

[Install]
WantedBy=default.target
